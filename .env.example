# ---------------------------------------------------------------------------
# API Keys for LLM Providers
# You only need to provide the key for the provider you intend to use.
# ---------------------------------------------------------------------------

# Which provider to use by default? Options: gemini, openai, groq
PRIMARY_LLM_PROVIDER=gemini

# Google Gemini (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ---------------------------------------------------------------------------
# HuggingFace & Whisper Settings (Windows Users Only)
# ---------------------------------------------------------------------------
# If you run into an OSError: [WinError 1314] while downloading models,
# uncomment the two lines below to disable symlinks:
# HF_HUB_DISABLE_SYMLINKS_WARNING=1
# HF_HUB_DISABLE_SYMLINKS=1
