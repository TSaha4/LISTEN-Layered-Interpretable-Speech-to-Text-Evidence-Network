    {
      "name": "chain where the last change was unreliable",
      "statements": [
        {"id": "a", "t": 1, "text": "We decided the launch is on Friday.", "values": ["Friday"], "topic": ["launch"], "polarity": 1, "reliability": 0.9},
        {"id": "b", "t": 2, "text": "We decided the launch moves to Monday.", "values": ["Monday"], "topic": ["launch"], "polarity": 1, "reliability": 0.9},
        {"id": "c", "t": 3, "text": "uh launch Wednesday maybe", "values": ["Wednesday"], "topic": ["launch"], "polarity": 1, "reliability": 0.3}
      ],
      "expected_relation": "disputes", "expected_active": "b"
    },
    {
      "name": "unrelated topics do not interact",
      "statements": [
        {"id": "a", "t": 1, "text": "We decided the launch is on Friday.", "values": ["Friday"], "topic": ["launch"], "polarity": 1, "reliability": 0.9},
        {"id": "b", "t": 2, "text": "Carol will book the venue for the offsite in Lisbon.", "values": [], "topic": ["offsite", "Lisbon"], "owner": "Carol", "polarity": 1, "reliability": 0.9}
      ],
      "expected_relation": null, "expected_active": "both"
    },
    {
      "name": "late statement both unreliable and same value: harmless reaffirm",
      "statements": [
        {"id": "a", "t": 1, "text": "We decided the launch is on Friday.", "values": ["Friday"], "topic": ["launch"], "polarity": 1, "reliability": 0.9},
        {"id": "b", "t": 2, "text": "um launch Friday yeah", "values": ["Friday"], "topic": ["launch"], "polarity": 1, "reliability": 0.35}
      ],
      "expected_relation": "reaffirms", "expected_active": "a"
    }
  ]
}
